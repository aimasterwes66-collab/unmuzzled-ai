  optim      [label="OPTIMIZER-BASED", fillcolor="#0a0a0a", color="#00ff88", fontcolor="#00ff88", fontsize=14];
  provider   [label="PROVIDER-SPECIFIC", fillcolor="#0a0a0a", color="#00ff88", fontcolor="#00ff88", fontsize=14];
  weights    [label="WEIGHTS-LEVEL", fillcolor="#0a0a0a", color="#ff3355", fontcolor="#ff3355", fontsize=14];
  tool       [label="TOOL / MCP", fillcolor="#0a0a0a", color="#00ff88", fontcolor="#00ff88", fontsize=14];
  multimodal [label="MULTIMODAL", fillcolor="#0a0a0a", color="#00ff88", fontcolor="#00ff88", fontsize=14];

  root -> identity;
  root -> encoding;
  root -> format;
  root -> divider;
  root -> multiturn;
  root -> optim;
  root -> provider;
  root -> weights;
  root -> tool;
  root -> multimodal;

